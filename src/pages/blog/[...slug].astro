---
import { type CollectionEntry, getCollection } from "astro:content";
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.svelte";
import Footer from "../../components/Footer.svelte";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const enPosts = posts.filter((post) => post.id.startsWith("en/"));
  return enPosts.map((post) => ({
    params: { slug: post.id.replace("en/", "") },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);

const formattedDate = new Date(post.data.pubDate).toLocaleDateString("en-us", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

// Calculate reading time
const wordCount = post.body?.split(/\s+/).length || 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 250));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={post.data.title} description={post.data.description} />
  </head>
  <body class="relative">
    <div class="ambient-glow"></div>
    <Header client:only="svelte" currentPath={Astro.url.pathname} />
    
    <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-24 relative z-10 reveal">
      <div class="mb-12">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-bold opacity-60 hover:opacity-100 hover:text-[var(--accent)] transition-all group px-4 py-2 rounded-full border border-transparent hover:border-[var(--border)] hover:bg-black/5 dark:hover:bg-white/5"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="group-hover:-translate-x-1 transition-transform"
            ><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Back to Blog
        </a>
      </div>
      
      <article class="prose prose-lg dark:prose-invert max-w-none">
        {
          post.data.cover_image && (
            <div class="mb-12 rounded-[2rem] overflow-hidden glass shadow-xl border border-[var(--border)] relative group">
              <div class="absolute inset-0 bg-[var(--accent)] mix-blend-overlay opacity-0 group-hover:opacity-20 transition-opacity duration-500 pointer-events-none z-10"></div>
              <Image
                src={post.data.cover_image}
                alt={post.data.title}
                class="w-full h-auto object-cover max-h-[500px] m-0 transition-transform duration-700 group-hover:scale-105"
              />
            </div>
          )
        }

        <header class="mb-16 text-center">
          <div class="text-[11px] font-bold text-[var(--subtle)] mb-6 tracking-widest uppercase flex flex-wrap items-center justify-center gap-3">
            <time>{formattedDate}</time>
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] opacity-60"></span>
            <span>{post.data.author}</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] opacity-60"></span>
            <span>~{readingTime} min read</span>
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tighter leading-tight mb-6 text-gradient">
            {post.data.title}
          </h1>
          {
            post.data.updatedDate && (
              <div class="italic text-sm font-medium opacity-60 mt-4">
                Last updated on{" "}
                <time>
                  {new Date(
                    post.data.updatedDate,
                  ).toLocaleDateString("en-us", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
              </div>
            )
          }
          <div class="mt-12 h-px w-24 mx-auto bg-gradient-to-r from-transparent via-[var(--accent)] to-transparent opacity-50"></div>
        </header>

        <div class="blog-content font-sans text-lg md:text-xl leading-relaxed text-[var(--text)] opacity-90 max-w-[65ch] mx-auto">
          <Content />
        </div>
      </article>
    </main>
    <Footer client:idle />
    
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelector('.reveal')?.classList.add('visible');
      });
      document.addEventListener('astro:page-load', () => {
        document.querySelector('.reveal')?.classList.add('visible');
      });
    </script>

    <style is:global>
      /* Blog Content Enhancements based on Design Dials */
      .blog-content h1,
      .blog-content h2,
      .blog-content h3,
      .blog-content h4 {
        font-weight: 800;
        margin-top: 2.5em;
        margin-bottom: 0.75em;
        letter-spacing: -0.025em;
        color: var(--text);
        line-height: 1.2;
      }
      .blog-content h2 {
        font-size: 2rem;
        position: relative;
        padding-bottom: 0.5rem;
      }
      .blog-content h2::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 40px;
        height: 3px;
        background: var(--accent);
        border-radius: 2px;
        opacity: 0.6;
      }
      .blog-content h3 {
        font-size: 1.5rem;
      }
      .blog-content p {
        margin-bottom: 1.75em;
        line-height: 1.8;
      }
      .blog-content a {
        color: var(--accent);
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;
        text-decoration-color: rgba(var(--accent-rgb), 0.4);
        transition: all 0.2s ease;
        font-weight: 600;
      }
      .blog-content a:hover {
        text-decoration-color: var(--accent);
        background: rgba(var(--accent-rgb), 0.1);
        border-radius: 4px;
      }
      .blog-content img {
        border-radius: 1.5rem;
        margin: 3em auto;
        border: 1px solid var(--border);
        box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1);
      }
      .blog-content blockquote {
        border-left: 4px solid var(--accent);
        padding: 1.5rem 1.5rem 1.5rem 2rem;
        margin: 2.5em 0;
        font-style: italic;
        background: linear-gradient(90deg, rgba(var(--accent-rgb),0.08) 0%, transparent 100%);
        border-radius: 0 1rem 1rem 0;
        color: var(--subtle);
        font-size: 1.1em;
      }
      .blog-content pre {
        padding: 1.5rem;
        border-radius: 1rem;
        overflow-x: auto;
        margin: 2.5em 0;
        font-size: 0.875rem;
        line-height: 1.7;
        border: 1px solid var(--border);
        box-shadow: 0 4px 20px -5px rgba(0,0,0,0.2);
        background: #0d0d0d !important;
      }
      .blog-content pre code {
        background: transparent !important;
        padding: 0;
        font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      }
      .blog-content :not(pre) > code {
        background: rgba(var(--accent-rgb), 0.1);
        color: var(--accent);
        padding: 0.2em 0.4em;
        border-radius: 0.4em;
        font-size: 0.85em;
        font-weight: 600;
        font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      }
      .blog-content ul, .blog-content ol {
        margin-bottom: 1.75em;
        padding-left: 1.25em;
      }
      .blog-content li {
        margin-bottom: 0.5em;
        line-height: 1.8;
      }
      .blog-content li::marker {
        color: var(--accent);
      }
    </style>
  </body>
</html>
