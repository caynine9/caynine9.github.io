---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.svelte";
import Footer from "../components/Footer.svelte";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const projects = [
	{
		title: "EDUNUSA",
		description:
			"Developing a comprehensive educational ecosystem using Kotlin Multiplatform (KMP), supporting both Android and iOS with Compose Multiplatform.",
		link: "#",
		tags: [
			"Kotlin Multiplatform",
			"Compose Multiplatform",
			"Android",
			"iOS",
		],
		category: "Work Related",
	},
	{
		title: "EDUNUSA CBT",
		description:
			"A Computer Based Test (CBT) application built with Kotlin Multiplatform (KMP) to ensure a seamless and secure examination experience across Android and iOS devices.",
		link: "#",
		tags: [
			"Kotlin Multiplatform",
			"Compose Multiplatform",
			"Android",
			"iOS",
		],
		category: "Work Related",
	},
	{
		title: "Moove",
		description:
			"Automatic Itinerary Vacation Planning app developed as a Bangkit 2024 Capstone Project. Features MVVM architecture and Retrofit integration.",
		link: "#",
		tags: ["Kotlin", "Android"],
		category: "Research Project",
	},
	{
		title: "FireGuard",
		description:
			"IoT-based Agrotech Innovation for real-time forest fire monitoring. Integrated OpenWeatherMap API and sensor communication via REST API.",
		link: "#",
		tags: ["Kotlin", "Android"],
		category: "Research Project",
	},
];

const experience = [
	{
		company: "Freelance",
		location: "Remote",
		role: "Mobile Developer",
		period: "Mar 2026 — Present",
		description:
			"Continuing the development and maintenance of the EDUNUSA ecosystem for PT Instrumeta Teknologi Nusantara as a freelance developer.",
		highlights: [
			"Migrated core components to Kotlin Multiplatform (KMP) for iOS support.",
			"Developing new features and optimizing existing codebase.",
			"Ensuring continuous delivery and app store maintenance.",
		],
	},
	{
		company: "PT Instrumeta Teknologi Nusantara",
		location: "Banjarbaru, South Kalimantan",
		role: "Mobile Developer (Contract)",
		period: "Nov 2025 — Feb 2026",
		description:
			"Developing modern Android applications using Kotlin and Jetpack Compose. Focused on educational tools and large-scale application ecosystems.",
		highlights: [
			"Developed EDUNUSA and EDUNUSA CBT.",
			"Integrated complex APIs for real-time data handling.",
			"Implemented clean architecture patterns for maintainable codebases.",
		],
	},
	{
		company: "Bangkit Academy 2024",
		location: "Remote (Google, GoTo, Traveloka)",
		role: "Mobile Development Cohort",
		period: "Feb 2024 — Jul 2024",
		description:
			"Intensive training on Android development and soft skills. Part of MSIB Kampus Merdeka Batch 6.",
		highlights: [
			"Mastered Android fundamentals and advanced concepts.",
			"Developed 'Moove' as a capstone project with a cross-functional team.",
		],
	},
];

const skillCategories = [
	{
		name: "Mobile Development",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
		skills: [
			"Kotlin",
			"Jetpack Compose",
			"Compose Multiplatform",
			"KMP",
			"Android Native",
			"Swift Fundamentals",
		],
	},
	{
		name: "Backend & Systems",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>`,
		skills: [
			"Java (Spring Boot)",
			"Go",
			"PostgreSQL",
			"MySQL",
			"RESTful API",
		],
	},
	{
		name: "Web & Tools",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
		skills: ["Svelte", "Tailwind CSS", "Git", "Postman"],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header client:load currentPath={Astro.url.pathname} />

		<!-- Ambient Background — static gradients, no animation -->
		<div class="ambient-glow"></div>

		<main class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-10">
			<!-- ==================== HERO ==================== -->
			<section class="pt-20 sm:pt-32 pb-24 sm:pb-32">
				<div class="grid grid-cols-1 md:grid-cols-[1.2fr_1fr] gap-12 lg:gap-20 items-center">
					<!-- Copy (Left) -->
					<div class="order-2 md:order-1 text-center md:text-left">
						<div class="reveal mb-8 flex justify-center md:justify-start">
							<span class="hero-chip">
								<span class="w-2 h-2 rounded-full bg-green-500 mr-2 shadow-[0_0_8px_rgba(34,197,94,0.6)]"></span>
								Available for Work
							</span>
						</div>
						
						<h1
							class="reveal reveal-delay-1 text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6 leading-[1.1]"
						>
							Hi, I'm <br class="hidden md:block"/><span style="color: var(--accent);">Tantowi.</span>
						</h1>
						<p
							class="reveal reveal-delay-2 text-lg sm:text-xl leading-relaxed mb-10 max-w-xl mx-auto md:mx-0"
							style="color: var(--subtle);"
						>
							I build high-performance <strong class="text-[var(--text)] font-semibold">mobile</strong> app experiences
							and robust <strong class="text-[var(--text)] font-semibold">backend</strong> systems.
						</p>

						<!-- CTA Buttons -->
						<div
							class="reveal reveal-delay-3 flex flex-col sm:flex-row justify-center md:justify-start items-stretch sm:items-center gap-4"
						>
							<a href="#contact" class="btn-primary">
								Get in Touch
							</a>
							<a href="#portfolio" class="btn-ghost">
								View Work &rarr;
							</a>
						</div>
					</div>

					<!-- Profile Photo (Right) -->
					<div class="order-1 md:order-2 flex justify-center md:justify-end reveal reveal-delay-2 mb-10 md:mb-0">
						<div class="relative group">
							<div
								class="w-40 h-40 sm:w-64 sm:h-64 rounded-[2rem] overflow-hidden shadow-2xl transition-transform duration-700 ease-out group-hover:-translate-y-2 group-hover:rotate-1"
							>
								<img
									src="/profile.webp"
									alt="Muhammad Tantowi Jauhari"
									class="w-full h-full object-cover"
									width="256"
									height="256"
									loading="eager"
								/>
							</div>
							<div class="absolute -inset-4 bg-gradient-to-tr from-[var(--accent)] to-transparent opacity-20 blur-2xl rounded-full -z-10 group-hover:opacity-40 transition-opacity duration-700"></div>
						</div>
					</div>
				</div>
			</section>

			<!-- ==================== EXPERIENCE ==================== -->
			<section class="py-24 sm:py-32 section-divider">
				<div class="max-w-3xl mx-auto">
					<div class="mb-16 reveal text-center md:text-left">
						<h2 class="section-title mb-2">Professional Journey</h2>
						<p class="text-lg mx-auto md:mx-0" style="color: var(--subtle);">A track record of building and shipping products.</p>
					</div>

					<div class="relative pl-8">
						<!-- Timeline Line -->
						<div class="timeline-line"></div>

						<div class="space-y-14">
							{experience.map((item, index) => (
								<div class={`reveal reveal-delay-${Math.min(index + 1, 4)} relative`}>
									<!-- Timeline Dot -->
									<div class="absolute -left-[32px] top-8 w-[14px] h-[14px] rounded-full border-2 border-[var(--accent)] bg-[var(--bg)] flex items-center justify-center translate-x-[0.5px]">
										<div class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></div>
									</div>

									<!-- Content -->
									<div class="card-elevated p-7 sm:p-8">
										<div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-5">
											<div>
												<h3 class="text-xl font-bold leading-tight">{item.role}</h3>
												<p class="text-sm font-medium mt-1" style="color: var(--subtle);">
													{item.company} · {item.location}
												</p>
											</div>
											<span class="tag-pill flex-shrink-0 self-start">{item.period}</span>
										</div>

										<p class="text-sm leading-relaxed mb-5" style="color: var(--subtle);">
											{item.description}
										</p>

										<ul class="space-y-2.5">
											{item.highlights.map(highlight => (
												<li class="flex items-start text-sm" style="color: var(--subtle);">
													<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mr-2.5 mt-0.5 flex-shrink-0" style="color: var(--accent);"><polyline points="20 6 9 17 4 12"></polyline></svg>
													<span>{highlight}</span>
												</li>
											))}
										</ul>
									</div>
								</div>
							))}
						</div>
					</div>
				</div>
			</section>

			<!-- ==================== PORTFOLIO ==================== -->
			<section
				id="portfolio"
				class="py-24 sm:py-32 section-divider"
			>
				<div class="text-center mb-16 reveal">
					<p class="section-overline">Portfolio</p>
					<h2 class="section-title">Featured Projects</h2>
					<p class="section-subtitle mx-auto">
						A selection of my recent personal and professional projects.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					{projects.map((project, index) => (
						<div class={`reveal reveal-delay-${Math.min(index + 1, 4)} card-elevated p-7 sm:p-8 flex flex-col h-full relative overflow-hidden group ${index === 0 ? 'md:col-span-3' : ''}`}>
							<!-- Accent top line -->
							<div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[var(--accent)] to-transparent opacity-40"></div>

							<div class={`flex items-center justify-between mb-6 ${index === 0 ? 'md:mb-10' : ''}`}>
								<span class="text-xs font-bold" style="color: var(--subtle);">
									{String(index + 1).padStart(2, '0')}
								</span>
								{project.category === "Work Related" && (
									<span class="tag-pill text-[10px]">
										<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mr-1"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /></svg>
										Work
									</span>
								)}
								{project.category === "Research Project" && (
									<span class="tag-pill text-[10px]">
										<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mr-1"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
										Research
									</span>
								)}
							</div>

							<h3 class={`font-bold mb-3 tracking-tight ${index === 0 ? 'text-3xl md:text-4xl' : 'text-2xl'}`}>
								{project.title}
							</h3>
							<p class={`leading-relaxed flex-grow ${index === 0 ? 'text-lg md:text-xl max-w-2xl mb-12' : 'text-sm mb-8'}`} style="color: var(--subtle);">
								{project.description}
							</p>

							<div class="flex flex-wrap gap-2 mt-auto">
								{project.tags.map((tag) => (
									<span class="tag-pill-neutral text-[10px]">
										{tag}
									</span>
								))}
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- ==================== SKILLS / TECH STACK ==================== -->
			<section class="py-24 sm:py-32 section-divider">
				<div class="mb-16 reveal text-center md:text-left">
					<h2 class="section-title mb-2">Technical Stack</h2>
					<p class="section-subtitle mx-auto md:mx-0">
						I leverage a diverse set of technologies to build
						scalable, modern applications across the entire stack.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-5 gap-6">
					{skillCategories.map((category, index) => (
						<div class={`reveal reveal-delay-${Math.min(index + 1, 3)} bento-cell p-7 sm:p-8 ${index === 0 ? 'md:col-span-3 bento-cell--accent' : 'md:col-span-2'}`}>
							<div class="mb-6 flex items-center gap-3">
								<div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background: rgba(var(--accent-rgb), 0.08); color: var(--accent);">
									<Fragment set:html={category.icon} />
								</div>
								<h3 class="text-base font-bold uppercase tracking-wider" style="color: var(--accent);">
									{category.name}
								</h3>
							</div>
							<div class="flex flex-wrap gap-2.5">
								{category.skills.map((skill) => (
									<span class="tag-pill-neutral cursor-default">
										{skill}
									</span>
								))}
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- ==================== CONTACT ==================== -->
			<section id="contact" class="py-24 sm:py-32 section-divider">
				<div class="reveal text-center max-w-3xl mx-auto">
					<h2 class="text-4xl sm:text-6xl font-bold tracking-tight mb-8">
						Let's work together.
					</h2>
					<p class="section-subtitle mb-12 mx-auto">
						I'm always open to discussing new projects, creative ideas, or opportunities to be part of your vision.
					</p>

					<div class="flex flex-wrap items-center justify-center gap-4">
						<a
							href="https://linkedin.com/in/mtantowij"
							target="_blank"
							class="btn-primary"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.761 0 5-2.239 5-5v-14c0-2.761-2.239-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
							LinkedIn
						</a>
						<a
							href="https://wa.me/628115114383"
							target="_blank"
							class="btn-primary"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.438 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884 0 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.199-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
							WhatsApp
						</a>
						<a
							href="mailto:tantowijauhari16@gmail.com"
							class="btn-ghost"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
							Email
						</a>
					</div>
				</div>
			</section>
		</main>

		<Footer client:idle />

		<!-- Scroll Reveal Observer -->
		<script is:inline>
			document.addEventListener('astro:page-load', () => {
				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('visible');
							observer.unobserve(entry.target);
						}
					});
				}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

				document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
			});
		</script>
	</body>
</html>
