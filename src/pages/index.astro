---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.svelte";
import Footer from "../components/Footer.svelte";
import Card from "../components/Card.svelte";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => post.id.startsWith("en/"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const projects = [
	{
		id: "edunusa",
		title: "EDUNUSA",
		subtitle: "Educational Ecosystem",
		tag: "Featured Ecosystem",
		role: "Lead Mobile Developer",
		description: "A comprehensive educational ecosystem engineered with Kotlin Multiplatform (KMP) and Compose Multiplatform, delivering unified native experiences across Android & iOS.",
		link: "#",
		deviceType: "mobile",
		stack: {
			core: ["Kotlin Multiplatform", "Compose Multiplatform"],
			mobile: ["Android Native", "Swift / iOS"],
			architecture: ["Clean Architecture", "Ktor", "Decompose"]
		},
		highlights: [
			"Unified codebase sharing 85%+ UI and business logic across iOS and Android.",
			"Seamless API synchronization with offline-first local cache.",
			"Implemented reactive state management with Decompose framework."
		]
	},
	{
		id: "edunusa-cbt",
		title: "EDUNUSA CBT",
		subtitle: "Computer Based Test Engine",
		tag: "Secure Assessment System",
		role: "Mobile Architect",
		description: "High-security examination engine with real-time state tracking, lock-down assessment environment, and zero-latency response recording for large-scale institutional testing.",
		link: "#",
		deviceType: "tablet",
		stack: {
			core: ["KMP", "Compose Multiplatform"],
			security: ["Secure Enclave Storage", "Anti-Cheat Lock"],
			data: ["Room DB", "Ktor HTTP"]
		},
		highlights: [
			"Zero-latency response logging with fault-tolerant offline persistence.",
			"Strict proctoring mechanisms to ensure examination integrity.",
			"Optimized for tablet resolution with split-pane exam layout."
		]
	},
	{
		id: "moove",
		title: "Moove",
		subtitle: "Smart Vacation Planner",
		tag: "Bangkit Capstone 2024",
		role: "Android Developer Lead",
		description: "AI-assisted itinerary generator application designed during Bangkit Academy 2024. Computes optimal travel routes, budget forecasts, and personalized attraction recommendations.",
		link: "#",
		deviceType: "mobile",
		stack: {
			mobile: ["Kotlin Native", "Jetpack Compose"],
			architecture: ["MVVM", "Coroutines & Flow"],
			networking: ["Retrofit", "Google Maps SDK"]
		},
		highlights: [
			"Selected as a top capstone project among 4,000+ Bangkit cohort participants.",
			"Integrated dynamic route generation with interactive map visualization.",
			"Automated budget calculations and daily schedule sorting."
		]
	},
	{
		id: "fireguard",
		title: "FireGuard",
		subtitle: "Forest Fire IoT Monitor",
		tag: "Agrotech Innovation",
		role: "Mobile & Systems Developer",
		description: "Real-time environmental monitoring app leveraging IoT sensor nodes and OpenWeatherMap telemetry to detect early wildfire anomalies and alert emergency responders.",
		link: "#",
		deviceType: "mobile",
		stack: {
			tech: ["Kotlin", "RESTful API", "IoT Telemetry"],
			services: ["OpenWeatherMap API", "Firebase Push Cloud"]
		},
		highlights: [
			"Real-time sensor telemetry processing with instant threshold alerts.",
			"Geospatial heatmap overlay for active fire risk zones.",
			"Emergency dispatch system integration via FCM notifications."
		]
	}
];

const experience = [
	{
		company: "Freelance",
		location: "Remote",
		role: "Mobile Developer",
		period: "Mar 2026 — Present",
		status: "Current",
		description: "Spearheading mobile architecture evolution and cross-platform component maintenance for PT Instrumeta Teknologi Nusantara.",
		highlights: [
			"Migrated core UI components to Compose Multiplatform for iOS parity.",
			"Optimized memory footprint and startup performance by 35%.",
			"Automated App Store & Play Store deployment pipelines."
		]
	},
	{
		company: "PT Instrumeta Teknologi Nusantara",
		location: "Banjarbaru, South Kalimantan",
		role: "Mobile Developer (Contract)",
		period: "Nov 2025 — Feb 2026",
		status: "Completed",
		description: "Architected production-grade Android and cross-platform applications focused on educational ecosystems.",
		highlights: [
			"Built EDUNUSA and EDUNUSA CBT from ground up.",
			"Implemented Clean Architecture and modular multi-module project structures.",
			"Integrated complex RESTful APIs with real-time web-socket updates."
		]
	},
	{
		company: "Bangkit Academy 2024",
		location: "Remote (Google, GoTo, Traveloka)",
		role: "Mobile Development Cohort",
		period: "Feb 2024 — Jul 2024",
		status: "Distinction",
		description: "Graduated from Google's intensive Android developer accelerator program under MSIB Kampus Merdeka.",
		highlights: [
			"Mastered advanced Android architecture, Jetpack libraries, and testing.",
			"Led mobile engineering for 'Moove' capstone project."
		]
	}
];

const skillCategories = [
	{
		name: "Mobile Ecosystem",
		accent: "from-purple-500/20 to-violet-600/20",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
		skills: ["Kotlin", "Jetpack Compose", "Compose Multiplatform", "Kotlin Multiplatform (KMP)", "Android Native", "Swift / iOS"]
	},
	{
		name: "Backend & Systems",
		accent: "from-indigo-500/20 to-blue-600/20",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>`,
		skills: ["Java (Spring Boot)", "Go", "PostgreSQL", "MySQL", "RESTful APIs", "Ktor Engine"]
	},
	{
		name: "Frontend & Tooling",
		accent: "from-fuchsia-500/20 to-pink-600/20",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
		skills: ["Svelte", "Tailwind CSS", "Git", "Postman", "Figma", "CI/CD Pipelines"]
	}
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="relative overflow-x-hidden">
    <!-- Ambient Background Lighting -->
    <div class="ambient-glow"></div>

    <Header client:load currentPath={Astro.url.pathname} />

    <main class="w-full">
      <!-- ==================== HERO SECTION (UNORTHODOX & BOLD) ==================== -->
      <section class="min-h-[92dvh] flex flex-col justify-center px-6 md:px-12 lg:px-24 pt-28 pb-16 relative overflow-hidden">
        <div class="max-w-7xl mx-auto w-full relative z-10">
          
          <!-- Top Floating Stats Bar -->
          <div class="reveal mb-12 flex flex-wrap items-center justify-between gap-4 border-b border-[var(--border)] pb-6">
            <div class="flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-[0_0_12px_rgba(16,185,129,0.8)] animate-pulse"></span>
              <span class="text-xs md:text-sm font-mono tracking-wider uppercase text-[var(--subtle)]">
                Available for Mobile & Systems Engineering
              </span>
            </div>
            <div class="flex items-center gap-6 text-xs font-mono text-[var(--subtle)]">
              <span>LOCATION: BANJARBARU, ID</span>
              <span>EST. 2026</span>
            </div>
          </div>

          <!-- Unorthodox Headline Grid -->
          <div class="relative mb-16">
            <!-- Laser Pulse Accents -->
            <div class="absolute left-0 top-1/2 -translate-y-1/2 w-[50vw] max-w-xl pointer-events-none -ml-8 lg:-ml-20 opacity-60">
              <div class="laser-line"></div>
              <div class="absolute right-0 top-1/2 -translate-y-1/2 text-[var(--accent)] font-bold text-6xl md:text-8xl lg:text-9xl transform translate-x-1/2 leading-none filter drop-shadow-[0_0_35px_var(--accent-glow)]">
                &#10033;
              </div>
            </div>

            <div class="reveal relative z-10 flex flex-col items-end text-right">
              <div class="inline-block glass px-4 py-1.5 rounded-full text-xs font-mono tracking-widest text-[var(--accent)] mb-4 border border-[var(--border)]">
                KOTLIN MULTIPLATFORM ARCHITECT
              </div>

              <h1 class="text-[13vw] sm:text-[11vw] md:text-9xl lg:text-[130px] font-extrabold tracking-tighter leading-none m-0 text-gradient select-none">
                Tantowi.
              </h1>
              
              <div class="max-w-xl mt-6 text-left self-start md:self-end md:text-right">
                <p class="text-lg md:text-2xl font-light leading-relaxed text-[var(--subtle)]">
                  Crafting high-performance <span class="text-[var(--text)] font-semibold border-b border-[var(--accent)]">mobile ecosystems</span> & robust <span class="text-[var(--text)] font-semibold border-b border-[var(--accent)]">backend architectures</span>.
                </p>
              </div>
            </div>
          </div>

          <!-- Bottom Action & Quick Skill Badges -->
          <div class="reveal flex flex-col md:flex-row items-stretch md:items-center justify-between gap-8 pt-8 border-t border-[var(--border)]">
            <div class="flex flex-wrap items-center gap-3">
              <span class="px-3 py-1.5 rounded-lg text-xs font-mono bg-black/5 dark:bg-white/5 border border-[var(--border)]">KMP / Compose</span>
              <span class="px-3 py-1.5 rounded-lg text-xs font-mono bg-black/5 dark:bg-white/5 border border-[var(--border)]">Android Native</span>
              <span class="px-3 py-1.5 rounded-lg text-xs font-mono bg-black/5 dark:bg-white/5 border border-[var(--border)]">Spring Boot / Go</span>
              <span class="px-3 py-1.5 rounded-lg text-xs font-mono bg-black/5 dark:bg-white/5 border border-[var(--border)]">Clean Architecture</span>
            </div>

            <div class="flex items-center gap-4 shrink-0">
              <a href="#contact" class="btn-primary">
                Start a Project
              </a>
              <a href="#portfolio" class="px-6 py-3 rounded-full border border-[var(--border)] font-semibold hover:bg-black/5 dark:hover:bg-white/5 transition-colors text-center text-sm">
                Explore Work &rarr;
              </a>
            </div>
          </div>

        </div>
      </section>

      <!-- ==================== PROFESSIONAL JOURNEY (BENTO TIMELINE) ==================== -->
      <section class="py-28 px-6 md:px-12 lg:px-24 border-y border-[var(--border)] bg-black/5 dark:bg-black/20 relative z-10">
        <div class="max-w-7xl mx-auto">
          
          <div class="reveal flex flex-col md:flex-row md:items-end justify-between mb-20 gap-6">
            <div>
              <div class="text-[var(--accent)] font-mono text-xs uppercase tracking-widest mb-3">01 // EXPERIENCE</div>
              <h2 class="text-4xl md:text-6xl font-extrabold tracking-tighter text-gradient">Professional Journey</h2>
            </div>
            <p class="text-base md:text-lg max-w-md opacity-70">
              Proven track record building enterprise mobile applications and scalable cross-platform systems.
            </p>
          </div>

          <!-- Asymmetric Journey Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            {experience.map((item, index) => (
              <div class={`reveal reveal-delay-${index + 1} ${index === 0 ? 'lg:col-span-12' : 'lg:col-span-6'} card-elevated p-8 md:p-10 relative overflow-hidden group`}>
                <!-- Corner glow -->
                <div class="absolute top-0 right-0 w-32 h-32 bg-[var(--accent)] opacity-5 blur-3xl group-hover:opacity-20 transition-opacity"></div>
                
                <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-6 border-b border-[var(--border)]">
                  <div>
                    <span class="text-xs font-mono text-[var(--accent)] uppercase tracking-wider block mb-1">{item.status}</span>
                    <h3 class="text-2xl md:text-3xl font-extrabold tracking-tight text-[var(--text)]">{item.role}</h3>
                    <div class="text-sm font-semibold opacity-70 mt-1">{item.company} &bull; {item.location}</div>
                  </div>
                  <span class="tag-pill text-xs font-mono">{item.period}</span>
                </div>

                <p class="text-base md:text-lg leading-relaxed mb-8 opacity-85">{item.description}</p>

                <div class="space-y-3">
                  {item.highlights.map(highlight => (
                    <div class="flex items-start text-sm md:text-base opacity-90">
                      <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] mr-3 mt-2 shrink-0"></span>
                      <span>{highlight}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>

        </div>
      </section>

      <!-- ==================== FEATURED PROJECTS (UNORTHODOX FULL-VIEWPORT SHOWCASE WITH ANIMATED CSS DEVICES) ==================== -->
      <section id="portfolio" class="py-24 relative z-10">
        <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24 mb-16">
          <div class="reveal flex flex-col md:flex-row md:items-end justify-between gap-6">
            <div>
              <div class="text-[var(--accent)] font-mono text-xs uppercase tracking-widest mb-3">02 // PORTFOLIO</div>
              <h2 class="text-4xl md:text-6xl font-extrabold tracking-tighter text-gradient">Featured Work</h2>
            </div>
            <p class="text-base md:text-lg max-w-md opacity-70">
              Deep dive into custom mobile engineering, KMP architecture, and high-security systems.
            </p>
          </div>
        </div>

        <!-- Full Viewport Alternating Project Sections -->
        <div class="space-y-24">
          {projects.map((project, i) => (
            <div class="min-h-[85dvh] flex flex-col justify-center py-16 px-6 md:px-12 lg:px-24 relative border-t border-[var(--border)] overflow-hidden bg-black/5 dark:bg-black/10">
              <!-- Ambient radial glow for each project -->
              <div class={`absolute top-1/2 ${i % 2 === 0 ? 'left-1/4' : 'right-1/4'} -translate-y-1/2 w-[500px] h-[500px] bg-[var(--accent)] opacity-10 blur-[120px] pointer-events-none rounded-full`}></div>

              <div class="max-w-7xl mx-auto w-full z-10">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
                  
                  <!-- Copy Column -->
                  <div class={`lg:col-span-6 reveal ${i % 2 !== 0 ? 'lg:order-last' : ''}`}>
                    
                    <div class="flex items-center gap-3 mb-6">
                      <span class="text-xs font-mono font-bold text-[var(--accent)] px-3 py-1 rounded-full bg-[rgba(var(--accent-rgb),0.1)] border border-[var(--border)]">
                        0{i+1} // {project.tag}
                      </span>
                      <span class="text-xs font-mono opacity-50 uppercase tracking-widest">{project.role}</span>
                    </div>

                    <h3 class="text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter mb-3 text-gradient">
                      {project.title}
                    </h3>
                    <div class="text-xl md:text-2xl font-semibold opacity-75 mb-6">{project.subtitle}</div>

                    <p class="text-lg md:text-xl leading-relaxed opacity-90 mb-8 max-w-xl">
                      {project.description}
                    </p>

                    <!-- Tech Stack Pills -->
                    <div class="mb-8">
                      <div class="text-xs font-mono uppercase tracking-widest text-[var(--subtle)] mb-3">TEKNOLOGI & ARSITEKTUR</div>
                      <div class="flex flex-wrap gap-2">
                        {Object.values(project.stack).flat().map((tech) => (
                          <span class="px-3 py-1.5 rounded-lg text-xs font-mono bg-black/5 dark:bg-white/5 border border-[var(--border)] font-semibold text-[var(--accent)]">
                            {tech}
                          </span>
                        ))}
                      </div>
                    </div>

                    <!-- Highlight Bullets -->
                    <div class="space-y-3 mb-10">
                      {project.highlights.map(h => (
                        <div class="flex items-start text-sm md:text-base opacity-85">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mr-3 mt-1 text-[var(--accent)] shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
                          <span>{h}</span>
                        </div>
                      ))}
                    </div>

                    {project.link !== "#" && (
                      <a href={project.link} target="_blank" class="btn-primary inline-flex items-center">
                        Visit Project
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                      </a>
                    )}
                  </div>

                  <!-- Animated CSS Device Frame Column -->
                  <div class="lg:col-span-6 reveal flex justify-center items-center">
                    
                    <div class="relative w-full max-w-lg group perspective-1000">
                      
                      <!-- Ambient Glow Behind Device -->
                      <div class="absolute -inset-4 bg-gradient-to-tr from-[var(--accent)] to-purple-600 rounded-[3rem] opacity-20 blur-3xl group-hover:opacity-40 transition-opacity duration-700 pointer-events-none"></div>

                      <!-- CSS Animated Phone/Tablet Frame -->
                      <div class="device-mockup-frame w-full aspect-[4/3] rounded-[2.5rem] glass border-4 border-[var(--border)] p-4 relative overflow-hidden shadow-2xl transition-all duration-700 group-hover:border-[var(--accent)] group-hover:translate-y-[-8px]">
                        
                        <!-- Internal Screen Layout -->
                        <div class="w-full h-full rounded-[1.8rem] bg-black/40 dark:bg-black/70 border border-[var(--border)] p-6 flex flex-col justify-between relative overflow-hidden">
                          
                          <!-- Scanline Animation effect -->
                          <div class="scanline-overlay"></div>

                          <!-- Top Device Bar -->
                          <div class="flex items-center justify-between border-b border-[var(--border)] pb-4 z-10">
                            <div class="flex items-center gap-2">
                              <span class="w-3 h-3 rounded-full bg-red-500/60"></span>
                              <span class="w-3 h-3 rounded-full bg-yellow-500/60"></span>
                              <span class="w-3 h-3 rounded-full bg-green-500/60"></span>
                            </div>
                            <span class="text-[10px] font-mono tracking-widest text-[var(--accent)] uppercase font-bold">
                              {project.id} // PREVIEW
                            </span>
                          </div>

                          <!-- Mockup Screen Body -->
                          <div class="my-auto text-center py-8 z-10">
                            <div class="text-4xl md:text-6xl font-black text-gradient uppercase tracking-tighter opacity-85 mb-2 group-hover:scale-105 transition-transform duration-500">
                              {project.title}
                            </div>
                            <div class="text-xs font-mono text-[var(--subtle)] tracking-widest uppercase">
                              [ App Interface Frame Placeholder ]
                            </div>
                          </div>

                          <!-- Bottom Device Telemetry -->
                          <div class="flex items-center justify-between border-t border-[var(--border)] pt-3 text-[10px] font-mono opacity-60 z-10">
                            <span>PLATFORM: {project.deviceType.toUpperCase()}</span>
                            <span class="flex items-center gap-1.5">
                              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                              READY FOR SCREENSHOT
                            </span>
                          </div>

                        </div>

                      </div>

                    </div>

                  </div>

                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ==================== TECH STACK (DESIGN TASTE BENTO) ==================== -->
      <section class="py-28 px-6 md:px-12 lg:px-24 border-y border-[var(--border)] bg-black/5 dark:bg-black/20">
        <div class="max-w-7xl mx-auto">
          
          <div class="reveal flex flex-col md:flex-row md:items-end justify-between mb-20 gap-6">
            <div>
              <div class="text-[var(--accent)] font-mono text-xs uppercase tracking-widest mb-3">03 // CAPABILITIES</div>
              <h2 class="text-4xl md:text-6xl font-extrabold tracking-tighter text-gradient">Technical Stack</h2>
            </div>
            <p class="text-base md:text-lg max-w-md opacity-70">
              Modern languages, frameworks, and cloud-native tools I use daily.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {skillCategories.map((category, index) => (
              <div class={`reveal reveal-delay-${index + 1} card-elevated p-8 relative overflow-hidden group hover:border-[var(--accent)] transition-all`}>
                <div class="mb-8 flex items-center gap-4">
                  <div class="w-12 h-12 rounded-2xl flex items-center justify-center bg-[rgba(var(--accent-rgb),0.1)] text-[var(--accent)] group-hover:scale-110 transition-transform shrink-0">
                    <Fragment set:html={category.icon} />
                  </div>
                  <h3 class="text-xl font-bold tracking-tight text-[var(--text)]">
                    {category.name}
                  </h3>
                </div>

                <div class="flex flex-wrap gap-2.5">
                  {category.skills.map((skill) => (
                    <span class="px-3.5 py-2 rounded-xl bg-black/5 dark:bg-white/5 border border-[var(--border)] text-sm font-semibold opacity-90 group-hover:border-[var(--accent)] transition-colors">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>

        </div>
      </section>

      <!-- ==================== BLOG TEASER ==================== -->
      <section class="py-28 px-6 md:px-12 lg:px-24">
        <div class="max-w-7xl mx-auto reveal">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
            <div>
              <div class="text-[var(--accent)] font-mono text-xs uppercase tracking-widest mb-3">04 // WRITING</div>
              <h2 class="text-4xl md:text-6xl font-extrabold tracking-tighter text-gradient">Latest Insights</h2>
            </div>
            <a href="/blog" class="btn-primary shrink-0">
              Explore All Articles
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {posts.map((post) => (
              <Card
                title={post.data.title}
                description={post.data.description}
                date={post.data.pubDate}
                url={`/blog/${post.id.replace("en/", "")}/`}
                coverImage={post.data.cover_image?.src}
                client:load
              />
            ))}
          </div>
        </div>
      </section>

      <!-- ==================== CONTACT SECTION ==================== -->
      <section id="contact" class="py-32 px-6 md:px-12 lg:px-24 border-t border-[var(--border)] bg-gradient-to-t from-[rgba(var(--accent-rgb),0.05)] to-transparent relative z-10">
