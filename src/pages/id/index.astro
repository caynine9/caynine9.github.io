---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.svelte";
import Footer from "../../components/Footer.svelte";
import Card from "../../components/Card.svelte";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import nebuImg from "../../assets/nebu.webp";
import edunusaImg from "../../assets/edunusa.webp";

const teaserImages: Record<string, any> = {
	nebu: nebuImg,
	"edunusa-suite": edunusaImg
};

const posts = (await getCollection("blog"))
  .filter((post) => post.id.startsWith("id/"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const projects = [
	{
		id: "nebu",
		title: "NEBU",
		subtitle: "Platform Top-Up Digital",
		tag: "Produksi Aktif (2026)",
		role: "Product Engineer / Full-stack Developer",
		link: "https://nebugame.id",
		description: "Platform top-up digital mandiri yang dibangun dengan Go dan Svelte untuk pemrosesan transaksi otomatis dan webhook sub-detik.",
		stackGroups: [
			{ name: "Bahasa & Framework", items: "Go (Golang), Svelte" },
			{ name: "Database & Antrean", items: "MySQL, Redis Queue" }
		]
	},
	{
		id: "edunusa-suite",
		title: "Ekosistem EDUNUSA",
		subtitle: "Ekosistem Pendidikan & CBT Engine",
		tag: "Produk Utama Enterprise (2025 - 2026)",
		role: "Lead Mobile Architect",
		link: "/id/projects#edunusa-suite",
		description: "Ekosistem mobile terpadu lintas platform yang berbagi 85%+ kode Kotlin untuk iOS & Android dengan proteksi kunci anti-curang.",
		stackGroups: [
			{ name: "Arsitektur Utama", items: "Kotlin Multiplatform (KMP), Compose Multiplatform" },
			{ name: "Keamanan & Cache", items: "Hardware Enclave, Room DB, Decompose" }
		]
	}
];

const experience = [
	{
		company: "Freelance",
		location: "Remote",
		role: "Mobile Developer",
		period: "Mar 2026 - Sekarang",
		status: "PERAN AKTIF",
		badgeBg: "bg-[rgba(var(--accent-rgb),0.1)] text-[var(--accent)] border-[rgba(var(--accent-rgb),0.3)]",
		cmd: "exec role --status=active",
		description: "Memimpin evolusi arsitektur mobile dan pemeliharaan komponen lintas platform untuk PT Instrumeta Teknologi Nusantara.",
		highlights: [
			"Memigrasi komponen UI inti ke Compose Multiplatform untuk paritas iOS.",
			"Mengoptimalkan penggunaan memori dan kinerja startup sebesar 35%.",
			"Membantu mengotomatiskan pipeline deployment App Store & Play Store."
		],
		impactPills: ["KMP Migration", "iOS Parity", "+35% Speed", "CI/CD Auto"]
	},
	{
		company: "PT Instrumeta Teknologi Nusantara",
		location: "Banjarbaru, Kalimantan Selatan",
		role: "Mobile Developer (Kontrak)",
		period: "Nov 2025 - Feb 2026",
		status: "SELESAI",
		badgeBg: "bg-[rgba(var(--accent-rgb),0.1)] text-[var(--accent)] border-[rgba(var(--accent-rgb),0.3)]",
		cmd: "build edunusa --target=production",
		description: "Merancang dan membangun aplikasi Android kelas produksi dan lintas platform yang berfokus pada ekosistem pendidikan.",
		highlights: [
			"Membangun EDUNUSA dan EDUNUSA CBT dari awal.",
			"Menerapkan Clean Architecture dan struktur proyek multi-modul modular.",
			"Mengintegrasikan RESTful API yang kompleks dengan pembaruan web-socket real-time."
		],
		impactPills: ["Clean Architecture", "EDUNUSA CBT", "Multi-Module", "WebSockets"]
	},
	{
		company: "Bangkit Academy 2024",
		location: "Remote (Google, GoTo, Traveloka)",
		role: "Mobile Development Cohort",
		period: "Feb 2024 - Jul 2024",
		status: "GRADUATE",
		badgeBg: "bg-[rgba(var(--accent-rgb),0.1)] text-[var(--accent)] border-[rgba(var(--accent-rgb),0.3)]",
		cmd: "graduate cohort",
		description: "Lulus dari program akselerator pengembang Android intensif Google di bawah MSIB Kampus Merdeka.",
		highlights: [
			"Menguasai arsitektur Android lanjutan, library Jetpack, dan pengujian (testing).",
			"Memimpin rekayasa seluler untuk proyek capstone 'Moove'."
		],
		impactPills: ["Capstone Project", "Jetpack Compose", "Android Architecture", "Google Certified"]
	}
];

const skillCategories = [
	{
		name: "Mobile Engineering",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
		desc: "Solusi Android Native & Lintas Platform",
		skills: [
			{ name: "Kotlin", tag: "Bahasa Utama", level: "Expert" },
			{ name: "Jetpack Compose", tag: "Mesin UI", level: "Advanced" },
			{ name: "Compose Multiplatform", tag: "iOS & Android", level: "Architect" },
			{ name: "Kotlin Multiplatform (KMP)", tag: "Logika Bersama", level: "Architect" },
			{ name: "Android Native", tag: "SDK & NDK", level: "Advanced" },
			{ name: "Swift / iOS", tag: "Integrasi Platform", level: "Intermediate" }
		]
	},
	{
		name: "Backend & Sistem",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>`,
		desc: "Penyimpanan & Layanan Mikro Konkurensi Tinggi",
		skills: [
			{ name: "Go (Golang)", tag: "API Kinerja Tinggi", level: "Advanced" },
			{ name: "Java (Spring Boot)", tag: "Enterprise", level: "Advanced" },
			{ name: "Ktor Engine", tag: "Kotlin HTTP", level: "Advanced" },
			{ name: "PostgreSQL & MySQL", tag: "Database Relasional", level: "Advanced" },
			{ name: "Redis", tag: "Antrean Asinkron & Cache", level: "Advanced" },
			{ name: "RESTful APIs", tag: "Integrasi", level: "Expert" }
		]
	},
	{
		name: "DevOps & Alat",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
		desc: "Deployment, Pemantauan & Web Stack",
		skills: [
			{ name: "Docker & VPS", tag: "Kontainer", level: "Advanced" },
			{ name: "Nginx & Cloudflare", tag: "Reverse Proxy", level: "Advanced" },
			{ name: "Grafana, Loki, Promtail", tag: "Telemetri", level: "Intermediate" },
			{ name: "Svelte", tag: "Frontend UI", level: "Advanced" },
			{ name: "Tailwind CSS", tag: "Styling", level: "Advanced" },
			{ name: "Git & Postman", tag: "Alur Kerja", level: "Expert" }
		]
	}
];
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="relative overflow-x-hidden">
    <!-- Ambient Background Mesh -->
    <div class="ambient-glow"></div>

    <Header client:load currentPath={Astro.url.pathname} />

    <main class="w-full">
      
      <!-- ==================== UPGRADED HERO SECTION ==================== -->
      <section class="min-h-[85dvh] flex flex-col justify-center px-6 md:px-12 lg:px-20 pt-20 md:pt-24 pb-12 relative overflow-hidden">
        
        <div class="max-w-7xl mx-auto w-full z-10 py-4">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
            
            <!-- Left Headline & Value Prop -->
            <div class="lg:col-span-8 reveal">
              <div class="text-xs font-mono text-[var(--accent)] tracking-widest uppercase mb-4 flex items-center gap-3">
                <span class="w-8 h-px bg-[var(--accent)]"></span>
                MUHAMMAD TANTOWI JAUHARI
              </div>

              <h1 class="text-4xl sm:text-5xl md:text-7xl lg:text-[96px] font-extrabold tracking-tighter leading-[0.95] mb-6 text-[var(--text)] select-none break-words">
                MEMBANGUN <br />
                PRODUK <span class="text-[var(--accent)]">MOBILE & SISTEM.</span>
              </h1>

              <p class="text-lg md:text-xl font-light leading-relaxed text-[var(--subtle)] max-w-2xl mb-8">
                Software Engineer yang menciptakan aplikasi <strong class="text-[var(--text)] font-semibold">Kotlin Multiplatform</strong> berkinerja tinggi, <strong class="text-[var(--text)] font-semibold">backend Go</strong>, dan platform digital otomatis.
              </p>

              <!-- Action Cluster -->
              <div class="flex flex-wrap items-center gap-4">
                <a href="/id/projects" class="btn-primary">
                  Jelajahi Proyek &rarr;
                </a>
                <a href="#contact" class="px-7 py-3.5 rounded-full border border-[var(--border)] text-[var(--text)] font-semibold hover:bg-[rgba(var(--accent-rgb),0.1)] transition-all text-sm focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:outline-none">
                  Mari Terhubung
                </a>
              </div>
            </div>

            <!-- Right Asymmetric Profile Anchor -->
            <div class="lg:col-span-4 reveal flex flex-col items-center lg:items-end">
              <div class="relative w-56 h-56 sm:w-64 sm:h-64 lg:w-80 lg:h-80 group">
                <!-- Glowing Accent Aura -->
                <div class="absolute -inset-6 bg-[var(--accent)] opacity-25 blur-3xl rounded-full group-hover:opacity-45 transition-opacity duration-700 pointer-events-none"></div>

                <!-- Angular Glass Frame -->
                <div class="w-full h-full rounded-[2.5rem] overflow-hidden glass border-2 border-[var(--border)] relative z-10 transform group-hover:scale-[1.02] transition-transform duration-500 shadow-2xl">
                  <img
                    src="/profile.webp"
                    alt="Muhammad Tantowi Jauhari"
                    class="w-full h-full object-cover transition-transform duration-[1.5s] hover:scale-105"
                    width="320"
                    height="320"
                    loading="eager"
                    fetchpriority="high"
                    decoding="sync"
                  />
                </div>
              </div>

              <!-- Profile Sub-Badge -->
              <div class="mt-4 glass px-5 py-2.5 rounded-2xl border border-[var(--border)] text-center backdrop-blur-md bg-[var(--bg)]/80 relative z-20">
                <span class="text-xs font-mono font-bold text-[var(--accent)] uppercase tracking-wider block">MOBILE & FULL-STACK ENGINEER</span>
                <span class="text-[10px] font-mono text-[var(--subtle)]">BANJARMASIN / INDONESIA</span>
              </div>
            </div>

          </div>
        </div>

      </section>

      <!-- ==================== FEATURED PROJECTS TEASER ==================== -->
      <section id="portfolio" class="py-20 px-6 md:px-12 lg:px-20 border-t border-[var(--border)] relative z-10">
        <div class="max-w-7xl mx-auto mb-12">
          <div class="reveal flex flex-col md:flex-row md:items-end justify-between gap-6">
            <div>
              <div class="text-xs font-mono text-[var(--accent)] tracking-widest uppercase mb-2 flex items-center gap-2">
                <span class="w-6 h-px bg-[var(--accent)]"></span>
                STUDI KASUS UNGGULAN
              </div>
              <h2 class="text-4xl md:text-5xl font-extrabold tracking-tighter text-[var(--text)] break-words">Sorotan Proyek</h2>
            </div>
            <a href="/id/projects" class="btn-primary text-xs py-3 px-6">
              Lihat Semua Showcase Demo &rarr;
            </a>
          </div>
        </div>

        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          {projects.map((project) => (
            <div class="reveal card-elevated p-8 flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="px-3 py-1 rounded-full bg-[rgba(var(--accent-rgb),0.08)] text-[var(--accent)] border border-[rgba(var(--accent-rgb),0.2)] text-xs font-mono font-semibold">
                    {project.tag}
                  </span>
                  <span class="text-xs font-mono text-[var(--subtle)]">PRODUKSI</span>
                </div>

                <h3 class="text-2xl sm:text-3xl font-extrabold text-[var(--text)] tracking-tight mb-2 group-hover:text-[var(--accent)] transition-colors">
                  {project.title} <span class="text-[var(--subtle)] font-light">| {project.subtitle}</span>
                </h3>

                <div class="my-4 rounded-xl overflow-hidden glass border border-[var(--border)] p-3 bg-black/10 dark:bg-black/30 flex items-center justify-center">
                  <Image
                    src={teaserImages[project.id]}
                    alt={project.title}
                    width={600}
                    height={400}
                    class="w-full h-48 object-contain rounded-lg transition-transform duration-500 group-hover:scale-105"
                    quality={90}
                    format="webp"
                  />
                </div>
                
                <p class="text-sm leading-relaxed text-[var(--subtle)] mb-6">
                  {project.description}
                </p>
              </div>

              <div class="mt-auto pt-6 border-t border-[var(--border)] flex items-center justify-between">
                <div class="text-xs font-mono text-[var(--subtle)]">
                  {project.role}
                </div>
                <a href={project.link === "#" ? "/id/projects" : project.link} target={project.link.startsWith("http") ? "_blank" : "_self"} class="inline-flex items-center gap-2 text-xs font-semibold text-[var(--accent)] hover:underline">
                  Pelajari Rincian &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>

        <div class="max-w-7xl mx-auto text-center reveal">
          <a href="/id/projects" class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl glass border border-[var(--border)] hover:border-[var(--accent)] hover:bg-[rgba(var(--accent-rgb),0.08)] transition-all font-bold text-[var(--text)] text-sm">
            <span>Lihat Halaman Proyek Lengkap dengan Mockup Interaktif</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </section>
      </section>

      <!-- ==================== CREATIVE HIGH-IMPACT PROFESSIONAL JOURNEY PIPELINE ==================== -->
      <section class="py-28 px-6 md:px-12 lg:px-20 border-t border-[var(--border)] relative z-10" style="content-visibility: auto; contain-intrinsic-size: 1000px;">
        <div class="max-w-7xl mx-auto">
          
          <div class="reveal flex flex-col md:flex-row md:items-end justify-between mb-20 gap-6">
            <div>
              <div class="text-xs font-mono text-[var(--accent)] tracking-widest uppercase mb-3 flex items-center gap-2">
                <span class="w-6 h-px bg-[var(--accent)]"></span>
                02 // JALUR KARIR
              </div>
              <h2 class="text-4xl md:text-6xl font-extrabold tracking-tighter text-[var(--text)] break-words">Perjalanan Profesional</h2>
            </div>
            <p class="text-base text-[var(--subtle)] max-w-md">
              Merekam jejak karir di berbagai startup dengan pertumbuhan tinggi, ekosistem mobile, dan kohort akselerator Google.
            </p>
          </div>

          <!-- Interactive Node Pipeline -->
          <div class="relative pl-6 md:pl-10 space-y-16 border-l-2 border-[var(--border)]">
            {experience.map((item, idx) => (
              <div class="reveal relative group">
                
                <!-- Pulsing Glow Node Marker -->
                <div class="absolute -left-[37px] md:-left-[53px] top-1.5 w-6 h-6 rounded-full bg-[var(--bg)] border-2 border-[var(--accent)] flex items-center justify-center shadow-[0_0_15px_var(--accent-glow)] group-hover:scale-125 transition-transform duration-500">
                  <span class="w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse"></span>
                </div>

                <!-- Main Experience Capsule Card -->
                <div class="rounded-3xl card-elevated p-6 sm:p-10 relative overflow-hidden">
                  
                  <!-- Top Terminal Command Bar -->
                  <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-[var(--border)]">
                    <div class="flex items-center gap-3">
                      <span class={`px-3 py-1 rounded-full text-xs font-mono font-bold border ${item.badgeBg}`}>
                        {item.status}
                      </span>
                      <span class="text-xs font-mono text-[var(--subtle)] font-semibold">{item.period}</span>
                    </div>

                    <div class="text-[11px] font-mono text-[var(--subtle)] bg-black/5 dark:bg-white/5 px-3 py-1 rounded-lg border border-[var(--border)] hidden sm:block">
                      $ {item.cmd}
                    </div>
                  </div>

                  <!-- Header Info -->
                  <div class="mb-6">
                    <h3 class="text-2xl sm:text-4xl font-extrabold text-[var(--text)] tracking-tight mb-2 group-hover:text-[var(--accent)] transition-colors break-words">
                      {item.role}
                    </h3>
                    <div class="text-base font-semibold text-[var(--subtle)] flex flex-wrap items-center gap-2">
                      <span class="text-[var(--accent)] break-words">{item.company}</span>
                      <span>&bull;</span>
                      <span class="font-mono text-xs opacity-80">{item.location}</span>
                    </div>
                  </div>

                  <!-- Description -->
                  <p class="text-base sm:text-lg leading-relaxed text-[var(--subtle)] mb-8 max-w-3xl">
                    {item.description}
                  </p>

                  <!-- Impact Pills Matrix -->
                  <div class="mb-8">
                    <div class="text-[11px] font-mono text-[var(--subtle)] uppercase tracking-widest mb-3">Dampak Utama:</div>
                    <div class="flex flex-wrap gap-2">
                      {item.impactPills.map((pill) => (
                        <span class="px-3 py-1.5 rounded-xl bg-[rgba(var(--accent-rgb),0.05)] border border-[rgba(var(--accent-rgb),0.2)] text-xs font-mono font-semibold text-[var(--accent)]">
                          {pill}
                        </span>
                      ))}
                    </div>
                  </div>

                  <!-- Highlights List -->
                  <div class="space-y-2.5 pt-4 border-t border-[var(--border)]">
                    {item.highlights.map((h) => (
                      <div class="flex items-start text-xs sm:text-sm text-[var(--subtle)]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mr-3 mt-0.5 text-[var(--accent)] shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>{h}</span>
                      </div>
                    ))}
                  </div>

                </div>

              </div>
            ))}
          </div>

        </div>
      </section>

      <!-- ==================== CREATIVE HIGH-IMPACT TECHNICAL STACK MATRIX ==================== -->
      <section class="py-28 px-6 md:px-12 lg:px-20 border-t border-[var(--border)] relative z-10" style="content-visibility: auto; contain-intrinsic-size: 1000px;">
        <div class="max-w-7xl mx-auto">
          
          <div class="reveal flex flex-col md:flex-row md:items-end justify-between mb-20 gap-6">
            <div>
              <div class="text-xs font-mono text-[var(--accent)] tracking-widest uppercase mb-3 flex items-center gap-2">
                <span class="w-6 h-px bg-[var(--accent)]"></span>
                03 // MATRIKS KEMAMPUAN
              </div>
              <h2 class="text-4xl md:text-6xl font-extrabold tracking-tighter text-[var(--text)] break-words">Tech Stack</h2>
            </div>
            <p class="text-base text-[var(--subtle)] max-w-md">
              Kemahiran teknis komprehensif, bahasa pemrograman produksi, framework microservice, dan alat DevOps.
            </p>
          </div>

          <!-- Stack Category Pods -->
          <div class="space-y-12">
            {skillCategories.map((cat) => (
              <div class="reveal card-elevated p-6 sm:p-10 relative overflow-hidden group">
                
                <!-- Category Top Header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-[var(--border)]">
                  <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-2xl bg-[rgba(var(--accent-rgb),0.1)] text-[var(--accent)] flex items-center justify-center shrink-0 border border-[rgba(var(--accent-rgb),0.2)] group-hover:scale-110 transition-transform">
                      <Fragment set:html={cat.icon} />
                    </div>
                    <div>
                      <h3 class="text-2xl sm:text-3xl font-extrabold text-[var(--text)] tracking-tight">{cat.name}</h3>
                      <div class="text-xs font-mono text-[var(--subtle)]">{cat.desc}</div>
                    </div>
                  </div>

                  <span class="text-xs font-mono text-[var(--accent)] font-semibold px-3 py-1 rounded-full bg-[rgba(var(--accent-rgb),0.1)] border border-[rgba(var(--accent-rgb),0.2)] shrink-0 self-start sm:self-auto">
                    {cat.skills.length} TEKNOLOGI
                  </span>
                </div>

                <!-- Skill Chips Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                  {cat.skills.map((skill) => (
                    <div class="p-4 rounded-2xl border border-[var(--border)] bg-black/5 dark:bg-white/5 hover:bg-[rgba(var(--accent-rgb),0.05)] hover:border-[rgba(var(--accent-rgb),0.4)] transition-all duration-300 flex items-center justify-between group/skill min-w-0">
                      <div class="min-w-0 pr-2">
                        <div class="text-sm font-extrabold text-[var(--text)] group-hover/skill:text-[var(--accent)] transition-colors truncate" title={skill.name}>{skill.name}</div>
                        <div class="text-[10px] font-mono text-[var(--subtle)] mt-0.5 truncate" title={skill.tag}>{skill.tag}</div>
                      </div>
                      <span class="text-[10px] font-mono font-bold text-[var(--accent)] px-2 py-0.5 rounded bg-[rgba(var(--accent-rgb),0.1)] border border-[rgba(var(--accent-rgb),0.2)] shrink-0">
                        {skill.level}
                      </span>
                    </div>
                  ))}
                </div>

              </div>
            ))}
          </div>

        </div>
      </section>

      <!-- ==================== BLOG ARTICLES ==================== -->
      <section class="py-24 px-6 md:px-12 lg:px-20 border-t border-[var(--border)] bg-black/5 dark:bg-white/5 relative z-10" style="content-visibility: auto; contain-intrinsic-size: 1000px;">
        <div class="max-w-7xl mx-auto reveal">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
            <div>
              <div class="text-xs font-mono text-[var(--accent)] tracking-widest uppercase mb-2">04 // ARTIKEL LOGCAT</div>
