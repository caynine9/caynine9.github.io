---
import { type CollectionEntry, getCollection } from "astro:content";
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.svelte";
import Footer from "../../../components/Footer.svelte";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const idPosts = posts.filter((post) => post.id.startsWith("id/"));
  return idPosts.map((post) => ({
    params: { slug: post.id.replace("id/", "") },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);

const formattedDate = new Date(post.data.pubDate).toLocaleDateString("id-ID", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

// Calculate reading time
const wordCount = post.body?.split(/\s+/).length || 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 250));
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead title={post.data.title} description={post.data.description} />
  </head>
  <body class="relative">
    <div class="ambient-glow"></div>
    <Header client:load currentPath={Astro.url.pathname} />
    
    <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-24 relative z-10 reveal">
      <div class="mb-12">
        <a
          href="/id/blog"
          class="inline-flex items-center gap-2 text-sm font-bold opacity-60 hover:opacity-100 hover:text-[var(--accent)] transition-all group px-4 py-2 rounded-full border border-transparent hover:border-[var(--border)] hover:bg-black/5 dark:hover:bg-white/5"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="group-hover:-translate-x-1 transition-transform"
            ><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Kembali ke Blog
        </a>
      </div>
      
      <article class="prose prose-lg dark:prose-invert max-w-none">
        {
          post.data.cover_image && (
            <div class="mb-12 rounded-[2rem] overflow-hidden glass shadow-xl border border-[var(--border)] relative group">
              <div class="absolute inset-0 bg-[var(--accent)] mix-blend-overlay opacity-0 group-hover:opacity-20 transition-opacity duration-500 pointer-events-none z-10"></div>
              <Image
                src={post.data.cover_image}
                alt={post.data.title}
                class="w-full h-auto object-cover max-h-[500px] m-0 transition-transform duration-700 group-hover:scale-105"
              />
            </div>
          )
        }

        <header class="mb-16 text-center">
          <div class="text-[11px] font-bold text-[var(--subtle)] mb-6 tracking-widest uppercase flex flex-wrap items-center justify-center gap-3">
            <time>{formattedDate}</time>
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] opacity-60"></span>
            <span>{post.data.author}</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] opacity-60"></span>
            <span>~{readingTime} mnt baca</span>
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tighter leading-tight mb-6 text-gradient">
            {post.data.title}
          </h1>
          {
            post.data.updatedDate && (
              <div class="italic text-sm font-medium opacity-60 mt-4">
                Terakhir diperbarui pada{" "}
                <time>
                  {new Date(
                    post.data.updatedDate,
                  ).toLocaleDateString("id-ID", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
              </div>
            )
          }
          <div class="mt-12 h-px w-24 mx-auto bg-gradient-to-r from-transparent via-[var(--accent)] to-transparent opacity-50"></div>
        </header>

        <div class="blog-content font-sans text-lg md:text-xl leading-relaxed text-[var(--text)] opacity-90 max-w-[65ch] mx-auto">
          <Content />
        </div>
      </article>
    </main>
    <Footer client:idle />
    
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelector('.reveal')?.classList.add('visible');
      });
      document.addEventListener('astro:page-load', () => {
        document.querySelector('.reveal')?.classList.add('visible');
      });
    </script>
  </body>
</html>
